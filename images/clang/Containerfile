# A second-vendor toolchain cell. clang from the pinned debian snapshot base,
# so the corpus can show that whether a leak is emitted depends on the vendor
# and not only the optimisation level. Two vendors is the minimum that can make
# that claim.
FROM docker.io/library/debian@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
ENV DEBIAN_FRONTEND=noninteractive SOURCE_DATE_EPOCH=0
RUN apt-get update \
 && apt-get install -y --no-install-recommends clang libc6-dev make binutils file \
 && rm -rf /var/lib/apt/lists/*
ENV CC=clang
WORKDIR /work
